#: includes/Analysis/Analyzer.php:56
msgid "Focus keyphrase is set."
msgstr "La frase chiave focus è impostata."

#: includes/Analysis/Analyzer.php:59
msgid "Add a focus keyphrase."
msgstr "Aggiungi una frase chiave focus."

#: includes/Analysis/Analyzer.php:64
msgid "Focus keyphrase (or a word form) appears in the SEO title."
msgstr "La frase chiave focus (o una forma flessa) compare nel titolo SEO."

#: includes/Analysis/Analyzer.php:67
msgid "Consider adding the focus keyphrase to the SEO title."
msgstr "Valuta di aggiungere la frase chiave focus al titolo SEO."

#: includes/Analysis/Analyzer.php:72
msgid "Focus keyphrase (or a word form) appears in the content."
msgstr "La frase chiave focus (o una forma flessa) compare nel contenuto."

#: includes/Analysis/Analyzer.php:75
msgid "Focus keyphrase was not found in the content."
msgstr "La frase chiave focus non è stata trovata nel contenuto."

#. translators: %s keyphrase
#: includes/Analysis/Analyzer.php:101
msgid "Related keyphrase “%s” (or synonym/word form) is used."
msgstr "La frase chiave correlata “%s” (o sinonimo/forma flessa) è usata."

#. translators: %s keyphrase
#: includes/Analysis/Analyzer.php:104
msgid "Add related keyphrase “%s” or a synonym naturally in the text."
msgstr ""
"Aggiungi la frase chiave correlata “%s” o un sinonimo in modo naturale nel "
"testo."

#: includes/Analysis/Analyzer.php:114
msgid "SEO title length looks good."
msgstr "La lunghezza del titolo SEO è adeguata."

#: includes/Analysis/Analyzer.php:117
msgid "SEO title should usually be 30–60 characters."
msgstr "Il titolo SEO di solito dovrebbe essere di 30–60 caratteri."

#: includes/Analysis/Analyzer.php:123
msgid "Meta description length looks good."
msgstr "La lunghezza della meta description è adeguata."

#: includes/Analysis/Analyzer.php:126
msgid "Meta description should usually be 70–160 characters."
msgstr "La meta description di solito dovrebbe essere di 70–160 caratteri."

#. translators: %d words
#: includes/Analysis/Analyzer.php:131
msgid "Content length is solid (%d words)."
msgstr "La lunghezza del contenuto è solida (%d parole)."

#. translators: %d words
#: includes/Analysis/Analyzer.php:134
msgid "Content is short (%d words). Aim for 300+ for competitive topics."
msgstr ""
"Il contenuto è breve (%d parole). Punta a 300+ per argomenti competitivi."

#: includes/Analysis/Analyzer.php:142
msgid "Average sentence length is easy to read."
msgstr "La lunghezza media delle frasi è facile da leggere."

#: includes/Analysis/Analyzer.php:145
msgid "Sentences are a bit long — shorter sentences improve readability."
msgstr ""
"Le frasi sono un po’ lunghe — frasi più brevi migliorano la leggibilità."

#: includes/Analysis/Analyzer.php:150
msgid "Content uses H2 subheadings."
msgstr "Il contenuto usa sottotitoli H2."

#: includes/Analysis/Analyzer.php:153
msgid "Add H2 subheadings to structure the page."
msgstr "Aggiungi sottotitoli H2 per strutturare la pagina."

